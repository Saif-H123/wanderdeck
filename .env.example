# Google Maps (client-side; restrict by HTTP referrer in GCP console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side Google APIs (Directions, Places) — separate key, restrict by API
GOOGLE_MAPS_SERVER_KEY=

# Anthropic (Claude — vision scoring + structured itinerary reasoning)
ANTHROPIC_API_KEY=

# Google Gemini (cheap first-pass image classification)
GEMINI_API_KEY=

# Supabase (auth + Postgres + storage for photo uploads)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
