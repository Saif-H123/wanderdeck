# Google Maps (client-side; restrict by HTTP referrer in GCP console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side Google APIs (Directions, Places) — separate key, restrict by API
GOOGLE_MAPS_SERVER_KEY=

# Anthropic (Claude — vision scoring + structured itinerary reasoning)
ANTHROPIC_API_KEY=

# Google Gemini (cheap first-pass image classification)
GEMINI_API_KEY=

# Supabase (Postgres + storage for photo uploads)
# Uses the newer "publishable / secret" key naming. The secret key has
# full admin access — server-only, never expose to clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Duffel (flight cost estimates). Test keys start with `duffel_test_`,
# live keys with `duffel_live_`. Server-side only.
DUFFEL_API_KEY=
